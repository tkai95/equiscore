# ─────────────────────────────────────────────────────────────
# SITE MODE
# One Next.js build is deployed to multiple hosts. Behaviour differs by mode:
#   public      — pure marketing, no auth (legacy equiscore.app build)
#   open        — full product + open Clerk sign-up (production main,
#                 equiscore.app)
#   invitation  — full product UI but gated to invited users (dev.equiscore.app)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_MODE=open

# ─────────────────────────────────────────────────────────────
# CLERK
# Dashboard: https://dashboard.clerk.com > API Keys.
# IMPORTANT: to stop the duplicate verification email, set a SINGLE Email
# verification strategy under User & Authentication > Email > Email
# verification (do not enable two strategies at once). This is a Dashboard
# setting, not an env var.
# Add each host (equiscore.app, dev.equiscore.app, admin.equiscore.app,
# partners.equiscore.app) to Allowed Origins for its Clerk instance.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# API base URL. Browser requests stay same-origin via /api/backend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
