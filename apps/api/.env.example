# ─────────────────────────────────────────────────────────────
# SUPABASE DATABASE
# https://supabase.com > your project > Settings > Database > URI
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────
# CLERK — https://dashboard.clerk.com > API Keys
# CLERK_ISSUER: JWT Templates > Clerk > "iss" field
# ─────────────────────────────────────────────────────────────
CLERK_ISSUER=https://xxxxx.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_...

# ─────────────────────────────────────────────────────────────
# TRUELAYER — OPEN BANKING (sandbox safe to test with)
# https://console.truelayer.com
# ─────────────────────────────────────────────────────────────
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_SANDBOX=true

# ─────────────────────────────────────────────────────────────
# SUPABASE STORAGE (S3-compatible)
# https://supabase.com > Project Settings > Storage > S3 Connection
# ─────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
# Paste the exact "Endpoint" from the S3 Connection page. Note the `.storage`
# subdomain — it is NOT <ref>.supabase.co. If unset, it's derived from the ref.
SUPABASE_S3_ENDPOINT=https://xxxxxxxxxxxx.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=eu-west-1
SUPABASE_STORAGE_BUCKET=equiscore-documents

# ─────────────────────────────────────────────────────────────
# APP URLS
# ─────────────────────────────────────────────────────────────
# API_URL: the API's OWN host (where OAuth/EB callbacks are handled).
API_URL=http://localhost:4000
# WEB_URL: the web app origin(s). Comma-separated allows several for CORS
# (e.g. a custom domain + the vercel.app domain); the first is used as the
# post-connection redirect target.
# Prod example: WEB_URL=https://dev.equiscore.app,https://equiscore-web.vercel.app
WEB_URL=http://localhost:3000
# Used for invite email links.
ADMIN_APP_URL=https://admin.equiscore.app
PARTNER_APP_URL=https://partners.equiscore.app
# Used for dev-access invite sign-up links.
DEV_APP_URL=https://dev.equiscore.app
PORT=4000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# EMAIL DELIVERY — RESEND
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be a sender address from a verified Resend domain.
INVITE_EMAIL_FROM=EquiScore <noreply@equiscore.app>

# ─────────────────────────────────────────────────────────────
# INSIGHTS
# ─────────────────────────────────────────────────────────────
# Enables the unauthenticated POST /insights/preview route for testing the
# insight-profile engine against anonymized statements. Fail-closed: leave
# unset (or anything other than "true") to keep it disabled. Never enable
# in production.
INSIGHTS_PREVIEW_ENABLED=true

# ENABLE BANKING — alternative Open Banking provider.
# Free "restricted production" lets you connect your OWN real accounts for testing
# with no AISP licence. https://enablebanking.com  (register an application, then:)
ENABLE_BANKING_APP_ID=       # application UUID — used as the JWT "kid"
ENABLE_BANKING_PRIVATE_KEY=  # RSA private key PEM (keep secret; \n-escaped is fine)
