# Prisma reads this file directly (it looks in the package the schema lives in,
# not the monorepo root), so a DATABASE_URL here is enough for db:push,
# db:studio and db:migrate to work locally.
#
# Copy to `.env` and fill in. Never commit the real file — `.env` is gitignored.
#
#   cp packages/database/.env.example packages/database/.env
#
# Local (docker-compose up -d) — matches docker-compose.yml credentials:
DATABASE_URL=postgresql://postgres:password@localhost:5432/equiscore

# Production: use the connection string from Supabase / Railway.
# DATABASE_URL=postgresql://...
