generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  authProviderId String     @unique @map("auth_provider_id")
  status         UserStatus @default(active)
  // Gates the Compass module (financial-coaching layer). Flipped on for
  // subscribers; default off. Read via /auth/me and enforced by the API guard.
  // Migration target once real billing exists: Clerk Billing has({plan}).
  compassEnabled Boolean    @default(false) @map("compass_enabled")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  profile                            UserProfile?
  addresses                          UserAddress[]
  employment                         EmploymentProfile[]
  bankConnections                    BankConnection[]
  documents                          UploadedDocument[]
  rentalProfiles                     RentalProfile[]
  trustFeatures                      TrustFeature[]
  trustScores                        TrustScore[]
  sharedProfiles                     SharedProfile[]
  importedOrganisationSharedProfiles OrganisationSharedProfile[] @relation("OrganisationSharedProfileImporter")
  statementImportJobs                StatementImportJob[]
  insightQuestionAnswers             InsightQuestionAnswer[]
  auditEvents                        AuditEvent[]
  organisationMemberships            OrganisationMember[]
  createdAssessmentRequests          AssessmentRequest[]         @relation("AssessmentRequestCreator")
  applicantAssessmentRequests        AssessmentRequest[]         @relation("AssessmentRequestApplicant")
  companyConsents                    CompanyConsent[]
  assessmentSnapshots                AssessmentSnapshot[]
  applicantAssessmentCases           AssessmentCase[]            @relation("AssessmentApplicant")
  assignedAssessmentCases            AssessmentCase[]            @relation("AssessmentReviewer")
  createdPolicies                    Policy[]                    @relation("PolicyCreator")
  createdPolicyVersions              PolicyVersion[]             @relation("PolicyVersionCreator")
  approvedPolicyVersions             PolicyVersion[]             @relation("PolicyVersionApprover")
  caseNotes                          CaseNote[]
  caseDecisions                      CaseDecision[]
  applicantUsageEvents               UsageEvent[]                @relation("UsageApplicant")
  initiatedUsageEvents               UsageEvent[]                @relation("UsageInitiator")
  organisationInvitationsSent        OrganisationInvitation[]    @relation("OrganisationInvitationInviter")
  organisationInvitationsAccepted    OrganisationInvitation[]    @relation("OrganisationInvitationAccepter")
  internalAdminAccesses              InternalAdminAccess[]       @relation("InternalAdminAccessUser")
  grantedInternalAdminAccesses       InternalAdminAccess[]       @relation("InternalAdminAccessGrantor")
  internalAdminInvitationsSent       InternalAdminInvitation[]   @relation("InternalAdminInvitationInviter")
  internalAdminInvitationsAccepted   InternalAdminInvitation[]   @relation("InternalAdminInvitationAccepter")
  internalAdminAuditEvents           InternalAdminAuditEvent[]   @relation("InternalAdminAuditActor")
  commitmentSettings                 CommitmentSetting[]
  reminders                          Reminder[]
  savingsGoals                       SavingsGoal[]
  consumerGoals                      ConsumerGoal[]
  compassDismissals                  CompassDismissal[]

  @@map("users")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

// ─── User Profile ──────────────────────────────────────────────────────────────

model UserProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique @map("user_id")
  fullName              String?          @map("full_name")
  dob                   DateTime?
  nationality           String?
  residencyStatus       ResidencyStatus? @map("residency_status")
  ukMoveDate            DateTime?        @map("uk_move_date")
  employmentType        EmploymentType?  @map("employment_type")
  monthlyIncomeDeclared Float?           @map("monthly_income_declared")
  monthlyRentDeclared   Float?           @map("monthly_rent_declared")
  profileStage          ProfileStage     @default(created) @map("profile_stage")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum ResidencyStatus {
  british_citizen
  settled_status
  pre_settled_status
  student_visa
  work_visa
  refugee
  asylum_seeker
  other

  @@map("residency_status")
}

enum EmploymentType {
  employed_full_time
  employed_part_time
  self_employed
  gig_worker
  student
  graduate
  unemployed
  other

  @@map("employment_type")
}

enum ProfileStage {
  created
  onboarding
  profile_building
  banking_connected
  documents_uploaded
  scored
  complete

  @@map("profile_stage")
}

// ─── Addresses ────────────────────────────────────────────────────────────────

model UserAddress {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  addressLine1 String    @map("address_line_1")
  addressLine2 String?   @map("address_line_2")
  city         String
  postcode     String
  country      String    @default("GB")
  fromDate     DateTime  @map("from_date")
  toDate       DateTime? @map("to_date")
  isCurrent    Boolean   @default(false) @map("is_current")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

// ─── Employment ───────────────────────────────────────────────────────────────

model EmploymentProfile {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  employmentType        EmploymentType @map("employment_type")
  employerName          String?        @map("employer_name")
  jobTitle              String?        @map("job_title")
  monthlyIncomeDeclared Float?         @map("monthly_income_declared")
  payFrequency          PayFrequency?  @map("pay_frequency")
  contractType          ContractType?  @map("contract_type")
  startDate             DateTime?      @map("start_date")
  endDate               DateTime?      @map("end_date")
  isCurrent             Boolean        @default(true) @map("is_current")
  createdAt             DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employment_profiles")
}

enum PayFrequency {
  weekly
  fortnightly
  monthly
  irregular

  @@map("pay_frequency")
}

enum ContractType {
  permanent
  fixed_term
  zero_hours
  freelance
  other

  @@map("contract_type")
}

// ─── Bank Connections ─────────────────────────────────────────────────────────

model BankConnection {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  providerName      String           @map("provider_name") // e.g. "truelayer"
  providerAccountId String?          @map("provider_account_id")
  institutionName   String?          @map("institution_name")
  connectionStatus  ConnectionStatus @default(pending) @map("connection_status")
  accessToken       String?          @map("access_token") // encrypted at rest
  refreshToken      String?          @map("refresh_token") // encrypted at rest
  tokenExpiresAt    DateTime?        @map("token_expires_at")
  consentId         String?          @map("consent_id")
  lastSyncedAt      DateTime?        @map("last_synced_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[]

  @@map("bank_connections")
}

enum ConnectionStatus {
  pending
  active
  expired
  error

  @@map("connection_status")
}

model BankAccount {
  id                  String      @id @default(cuid())
  bankConnectionId    String      @map("bank_connection_id")
  externalAccountId   String      @map("external_account_id")
  accountName         String?     @map("account_name")
  accountHolderName   String?     @map("account_holder_name")
  accountType         AccountType @map("account_type")
  currency            String      @default("GBP")
  maskedAccountNumber String?     @map("masked_account_number")
  currentBalance      Float?      @map("current_balance")
  syncedAt            DateTime?   @map("synced_at")
  createdAt           DateTime    @default(now()) @map("created_at")

  bankConnection BankConnection    @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]
  directDebits   DirectDebit[]
  standingOrders StandingOrder[]

  @@unique([bankConnectionId, externalAccountId])
  @@map("bank_accounts")
}

model DirectDebit {
  id                  String    @id @default(cuid())
  bankAccountId       String    @map("bank_account_id")
  externalId          String    @map("external_id")
  name                String?
  reference           String?
  previousAmount      Float?    @map("previous_amount")
  currency            String    @default("GBP")
  status              String    @default("active")
  previousPaymentDate DateTime? @map("previous_payment_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, externalId])
  @@map("direct_debits")
}

model StandingOrder {
  id                String    @id @default(cuid())
  bankAccountId     String    @map("bank_account_id")
  externalId        String    @map("external_id")
  reference         String?
  currency          String    @default("GBP")
  frequency         String?
  status            String    @default("active")
  nextPaymentDate   DateTime? @map("next_payment_date")
  nextPaymentAmount Float?    @map("next_payment_amount")
  firstPaymentDate  DateTime? @map("first_payment_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, externalId])
  @@map("standing_orders")
}

enum AccountType {
  current
  savings
  credit_card
  business

  @@map("account_type")
}

model BankTransaction {
  id            String               @id @default(cuid())
  bankAccountId String               @map("bank_account_id")
  externalTxnId String               @map("external_txn_id")
  bookedAt      DateTime             @map("booked_at")
  amount        Float
  currency      String               @default("GBP")
  description   String?
  merchantName  String?              @map("merchant_name")
  category      TransactionCategory?
  direction     TransactionDirection
  rawPayload    Json?                @map("raw_payload")
  createdAt     DateTime             @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, externalTxnId])
  @@index([bankAccountId, bookedAt])
  @@index([category])
  @@map("bank_transactions")
}

enum TransactionDirection {
  credit
  debit

  @@map("transaction_direction")
}

enum TransactionCategory {
  salary
  rent_payment
  groceries
  transport
  utilities
  savings_transfer
  loan_repayment
  entertainment
  healthcare
  education
  gig_income
  government_benefit
  investment
  cash_withdrawal
  other

  @@map("transaction_category")
}

// ─── Documents ────────────────────────────────────────────────────────────────

model UploadedDocument {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  documentType       DocumentType       @map("document_type")
  fileUrl            String             @map("file_url")
  fileKey            String             @map("file_key") // S3 key
  fileSizeBytes      Int?               @map("file_size_bytes")
  mimeType           String?            @map("mime_type")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  extractedMetadata  Json?              @map("extracted_metadata")
  uploadedAt         DateTime           @default(now()) @map("uploaded_at")
  reviewedAt         DateTime?          @map("reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("uploaded_documents")
}

enum DocumentType {
  passport
  national_id
  biometric_residence_permit
  driving_licence
  bank_statement
  payslip
  employment_letter
  tenancy_agreement
  utility_bill
  p60
  p45
  tax_return
  other

  @@map("document_type")
}

enum VerificationStatus {
  pending
  verified
  rejected
  needs_review

  @@map("verification_status")
}

// ─── Rental Profiles ──────────────────────────────────────────────────────────

model RentalProfile {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  monthlyRentDeclared Float?    @map("monthly_rent_declared")
  landlordName        String?   @map("landlord_name")
  tenancyStartDate    DateTime? @map("tenancy_start_date")
  tenancyEndDate      DateTime? @map("tenancy_end_date")
  propertyAddress     String?   @map("property_address")
  isCurrent           Boolean   @default(true) @map("is_current")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rental_profiles")
}

// ─── Trust Features ───────────────────────────────────────────────────────────

model TrustFeature {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  featureKey       String   @map("feature_key")
  featureValueNum  Float?   @map("feature_value_num")
  featureValueText String?  @map("feature_value_text")
  featureValueBool Boolean? @map("feature_value_bool")
  scoreVersion     String   @map("score_version")
  computedAt       DateTime @default(now()) @map("computed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureKey])
  @@map("trust_features")
}

// ─── Trust Scores ─────────────────────────────────────────────────────────────

model TrustScore {
  id                        String        @id @default(cuid())
  userId                    String        @map("user_id")
  scorecardType             ScorecardType @map("scorecard_type")
  scoreVersion              String        @map("score_version")
  profileCompletenessScore  Float         @map("profile_completeness_score")
  verificationStrengthScore Float         @map("verification_strength_score")
  identityConfidenceScore   Float         @map("identity_confidence_score")
  incomeStabilityScore      Float         @map("income_stability_score")
  affordabilityScore        Float         @map("affordability_score")
  rentalReliabilityScore    Float         @map("rental_reliability_score")
  financialStabilityScore   Float         @map("financial_stability_score")
  overallScore              Float         @map("overall_score")
  overallTier               TrustTier     @map("overall_tier")
  fraudRisk                 FraudRisk     @map("fraud_risk")
  reasonCodes               Json          @map("reason_codes")

  // ── Freshness ───────────────────────────────────────────────────────────────
  // A score is an attestation about evidence up to a point in time. Validity is
  // anchored to the latest date the *evidence* covers, never to when it was
  // uploaded or computed — an old statement uploaded today buys no freshness.
  financialDataAsOf DateTime? @map("financial_data_as_of")
  validUntil        DateTime? @map("valid_until")

  // Which evidence sources backed this score, and their status at computation.
  // Lets a recipient view detect a score whose evidence has since disappeared.
  evidenceManifest Json? @map("evidence_manifest")

  // Non-raw feature summary, written at computation time. This is what allows a
  // historical score to stay explainable after its raw evidence is deleted —
  // it cannot be reconstructed later, so it must be captured here.
  featureSnapshot Json? @map("feature_snapshot")

  computedAt DateTime @default(now()) @map("computed_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Retained as the snapshot that was current when the link was created (audit).
  // Recipient views resolve the applicant's *latest* score, never this one.
  sharedProfiles SharedProfile[]

  @@index([userId, computedAt])
  @@map("trust_scores")
}

enum ScorecardType {
  general
  tenant
  lender_readiness
  telecom

  @@map("scorecard_type")
}

enum TrustTier {
  A
  B
  C
  D
  E

  @@map("trust_tier")
}

enum FraudRisk {
  pass
  review
  high_risk

  @@map("fraud_risk")
}

// ─── Shared Profiles ──────────────────────────────────────────────────────────

model SharedProfile {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  trustScoreId    String    @map("trust_score_id")
  shareToken      String    @unique @map("share_token")
  expiresAt       DateTime  @map("expires_at")
  targetType      String?   @map("target_type") // "landlord", "employer", "lender"
  targetName      String?   @map("target_name")
  viewCount       Int       @default(0) @map("view_count")
  lastViewedAt    DateTime? @map("last_viewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  // Recipient insight frozen at share time — a share link is a point-in-time
  // snapshot and must never change as the applicant's later evidence changes.
  insightSnapshot Json?     @map("insight_snapshot")

  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustScore          TrustScore                  @relation(fields: [trustScoreId], references: [id])
  companyConsents     CompanyConsent[]
  organisationIntakes OrganisationSharedProfile[]

  @@map("shared_profiles")
}

// ─── Company Assessment Workspace ────────────────────────────────────────────
// B2B layer over the existing consumer profile, evidence, insight, scoring and
// sharing capabilities. These records orchestrate, freeze and evaluate existing
// EquiScore outputs; they are not a second financial-analysis system.

model Organisation {
  id                         String             @id @default(cuid())
  name                       String
  slug                       String             @unique
  status                     OrganisationStatus @default(active)
  planName                   String?            @map("plan_name")
  monthlyAssessmentAllowance Int                @default(0) @map("monthly_assessment_allowance")
  overageUnitPrice           Float?             @map("overage_unit_price")
  currency                   String             @default("GBP")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  members                  OrganisationMember[]
  invitations              OrganisationInvitation[]
  assessmentRequests       AssessmentRequest[]
  sharedProfiles           OrganisationSharedProfile[]
  companyConsents          CompanyConsent[]
  assessmentSnapshots      AssessmentSnapshot[]
  assessmentCases          AssessmentCase[]
  policies                 Policy[]
  policyVersions           PolicyVersion[]
  caseNotes                CaseNote[]
  caseDecisions            CaseDecision[]
  usageEvents              UsageEvent[]
  auditEvents              OrganisationAuditEvent[]
  internalAdminAuditEvents InternalAdminAuditEvent[]

  @@map("organisations")
}

enum OrganisationStatus {
  active
  suspended
  archived

  @@map("organisation_status")
}

model OrganisationMember {
  id             String                   @id @default(cuid())
  organisationId String                   @map("organisation_id")
  userId         String                   @map("user_id")
  role           OrganisationMemberRole   @default(reviewer)
  status         OrganisationMemberStatus @default(active)
  invitedAt      DateTime?                @map("invited_at")
  joinedAt       DateTime?                @map("joined_at")
  lastActiveAt   DateTime?                @map("last_active_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, role])
  @@map("organisation_members")
}

model OrganisationInvitation {
  id             String                       @id @default(cuid())
  organisationId String                       @map("organisation_id")
  email          String
  role           OrganisationMemberRole       @default(reviewer)
  status         OrganisationInvitationStatus @default(pending)
  token          String                       @unique
  invitedById    String?                      @map("invited_by_id")
  acceptedById   String?                      @map("accepted_by_id")
  expiresAt      DateTime                     @map("expires_at")
  acceptedAt     DateTime?                    @map("accepted_at")
  revokedAt      DateTime?                    @map("revoked_at")
  metadata       Json?
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrganisationInvitationInviter", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("OrganisationInvitationAccepter", fields: [acceptedById], references: [id])

  @@index([email, status])
  @@index([organisationId, status])
  @@map("organisation_invitations")
}

enum OrganisationInvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("organisation_invitation_status")
}

enum OrganisationMemberRole {
  owner
  admin
  policy_admin
  reviewer
  manager
  billing_admin
  auditor

  @@map("organisation_member_role")
}

enum OrganisationMemberStatus {
  invited
  active
  suspended
  removed

  @@map("organisation_member_status")
}

model OrganisationSharedProfile {
  id              String                          @id @default(cuid())
  organisationId  String                          @map("organisation_id")
  sharedProfileId String                          @map("shared_profile_id")
  importedById    String                          @map("imported_by_id")
  status          OrganisationSharedProfileStatus @default(ready_to_assess)
  source          String                          @default("partner_import")
  notes           String?
  importedAt      DateTime                        @default(now()) @map("imported_at")
  updatedAt       DateTime                        @updatedAt @map("updated_at")
  acceptedAt      DateTime?                       @map("accepted_at")
  declinedAt      DateTime?                       @map("declined_at")
  assessedAt      DateTime?                       @map("assessed_at")

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sharedProfile SharedProfile @relation(fields: [sharedProfileId], references: [id], onDelete: Cascade)
  importedBy    User          @relation("OrganisationSharedProfileImporter", fields: [importedById], references: [id])

  @@unique([organisationId, sharedProfileId])
  @@index([organisationId, status])
  @@index([sharedProfileId])
  @@map("organisation_shared_profiles")
}

enum OrganisationSharedProfileStatus {
  ready_to_assess
  assessed
  declined
  expired
  revoked

  @@map("organisation_shared_profile_status")
}

model AssessmentRequest {
  id                 String                  @id @default(cuid())
  organisationId     String                  @map("organisation_id")
  applicantId        String?                 @map("applicant_id")
  applicantEmail     String                  @map("applicant_email")
  applicantName      String?                 @map("applicant_name")
  assessmentType     CompanyAssessmentType   @map("assessment_type")
  policyVersionId    String?                 @map("policy_version_id")
  proposedCommitment Float?                  @map("proposed_commitment")
  reference          String?
  status             AssessmentRequestStatus @default(draft)
  requestToken       String?                 @unique @map("request_token")
  deadline           DateTime?
  createdById        String                  @map("created_by_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  sentAt             DateTime?               @map("sent_at")
  completedAt        DateTime?               @map("completed_at")
  cancelledAt        DateTime?               @map("cancelled_at")

  organisation  Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  applicant     User?            @relation("AssessmentRequestApplicant", fields: [applicantId], references: [id])
  createdBy     User             @relation("AssessmentRequestCreator", fields: [createdById], references: [id])
  policyVersion PolicyVersion?   @relation(fields: [policyVersionId], references: [id])
  consents      CompanyConsent[]
  cases         AssessmentCase[]

  @@index([organisationId, status])
  @@index([applicantEmail])
  @@map("assessment_requests")
}

enum CompanyAssessmentType {
  rental
  telecom
  utilities
  lending
  other

  @@map("company_assessment_type")
}

enum AssessmentRequestStatus {
  draft
  invitation_scheduled
  invitation_sent
  applicant_opened
  applicant_started
  information_incomplete
  awaiting_consent
  ready_for_assessment
  assessment_delivered
  declined
  expired
  cancelled

  @@map("assessment_request_status")
}

model CompanyConsent {
  id                  String                @id @default(cuid())
  organisationId      String                @map("organisation_id")
  applicantId         String                @map("applicant_id")
  assessmentRequestId String?               @map("assessment_request_id")
  sharedProfileId     String?               @map("shared_profile_id")
  assessmentType      CompanyAssessmentType @map("assessment_type")
  purpose             String?
  permittedDataScope  Json                  @map("permitted_data_scope")
  consentTextVersion  String                @map("consent_text_version")
  status              CompanyConsentStatus  @default(granted)
  grantedAt           DateTime?             @map("granted_at")
  expiresAt           DateTime?             @map("expires_at")
  revokedAt           DateTime?             @map("revoked_at")
  companyReference    String?               @map("company_reference")
  createdAt           DateTime              @default(now()) @map("created_at")

  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  applicant         User                 @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  assessmentRequest AssessmentRequest?   @relation(fields: [assessmentRequestId], references: [id])
  sharedProfile     SharedProfile?       @relation(fields: [sharedProfileId], references: [id])
  snapshots         AssessmentSnapshot[]
  cases             AssessmentCase[]

