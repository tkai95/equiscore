  custom

  @@map("goal_type")
}

enum GoalStatus {
  active
  achieved
  archived

  @@map("goal_status")
}

/// A dismissed Compass suggestion (e.g. a savings opportunity), so it does not
/// keep returning. Keyed by kind + the suggestion's stable id.
model CompassDismissal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String
  key       String
  createdAt DateTime @default(now()) @map("created_at")

