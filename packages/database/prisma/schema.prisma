// Captures the user's explanation of a flagged/ambiguous transaction (an
// anomalous data point). The questionId matches the engine's follow-up-question
// id, so feeding answered ids back as resolvedQuestionIds clears the flag,
// raises transaction clarity, and updates the Trust Score.

model InsightQuestionAnswer {
